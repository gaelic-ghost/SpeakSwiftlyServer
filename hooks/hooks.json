{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_HOME:-$HOME/.codex}/plugins/speak-swiftly/hooks/permission-request-log.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_HOME:-$HOME/.codex}/plugins/speak-swiftly/hooks/stop-tts.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
