{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CODEX_HOOK_TTS_DATA_DIR=\"$(git rev-parse --show-toplevel)/.codex\" node \"$(git rev-parse --show-toplevel)/hooks/permission-request-log.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CODEX_HOOK_TTS_DATA_DIR=\"$(git rev-parse --show-toplevel)/.codex\" node \"$(git rev-parse --show-toplevel)/hooks/stop-tts.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
